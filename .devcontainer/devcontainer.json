{
  "name": "EchoCloud Personal Workstation",
  "build": { "dockerfile": "Dockerfile", "context": ".." },
  "forwardPorts": [6080, 5901, 8000],
  "portsAttributes": {
    "6080": { "label": "EchoCloud Desktop", "onAutoForward": "openPreview", "visibility": "private" },
    "5901": { "label": "VNC", "visibility": "private" },
    "8000": { "label": "EchoCloud API", "visibility": "private" }
  },
  "postCreateCommand": "bash /workspaces/codespaces-blank/scripts/provision.sh",
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "runArgs": ["--shm-size=1g"],
  "customizations": { "vscode": { "extensions": ["ms-python.python", "golang.go", "ms-vscode.cpptools"] } }
}
